{
  "version": 2,
  "framework": null,
  "buildCommand": null,
  "installCommand": null,
  "outputDirectory": "public",
  "trailingSlash": false,
  "headers": [
    {
      "source": "/visualacuity/:path*",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.identitetherapeutics.com"
        }
      ],
      "destination": "https://identitetherapeutics.com/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/visualacuity",
      "destination": "/visualacuity/index.html"
    },
    {
      "source": "/visualacuity/support",
      "destination": "/visualacuity/support/index.html"
    },
    {
      "source": "/visualacuity/privacy",
      "destination": "/visualacuity/privacy/index.html"
    }
  ]
}
